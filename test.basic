10 POKE 16384, 0 
11 POKE 16385, 1
12 POKE 16386, 29
13 POKE 16387, 0
15 PRINT "CP=", PEEK(16392), PEEK(16393)
20 POKE 16387, 1
25 C=0
30 FOR I = 0 TO 2640 + 1600
40 POKE 16387, 1
45 POKE 16386, C
50 IF C<255 THEN C=C+1
55 IF C=255 THEN C=0
60 PRINT I, "CP=", PEEK(16392), PEEK(16393)
65 PRINT I, "PS=", PEEK(16394), PEEK(16395)
66 PRINT I, "PE=", PEEK(16396), PEEK(16397)
70 NEXT I